# Reference values for running Go on the host. Export these into your shell;
# the application does not automatically load .env files.
HTTP_ADDR=127.0.0.1:8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=elimin8

# The embedded MQTT broker uses /api/mqtt on HTTP_ADDR (WebSockets).
# No separate broker URL, port, anonymous session, or signing secret is required.

# Optional native photo storage. Leave endpoint and credentials empty to disable.
# With Compose RustFS, set endpoint to http://127.0.0.1:9000 (or PHOTO_STORAGE_PORT)
# and export the same credentials you set in the root .env.
PHOTO_STORAGE_PROVIDER=rustfs
PHOTO_STORAGE_ENDPOINT=
PHOTO_STORAGE_REGION=us-east-1
PHOTO_STORAGE_BUCKET=elimin8-photos
PHOTO_STORAGE_ACCESS_KEY=
PHOTO_STORAGE_SECRET_KEY=

# Positive whole hours after game end; photos become unreadable at this deadline.
PHOTO_RETENTION_HOURS=24
