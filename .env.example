# Optional overrides for docker compose host port bindings.
# Copy to .env and adjust if the defaults conflict with something
# already running on your machine. Compose loads .env automatically.
MONGODB_PORT=27017
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Local private photo storage (RustFS); API host port only, console is disabled.
PHOTO_STORAGE_PORT=9000
PHOTO_STORAGE_REGION=us-east-1
PHOTO_STORAGE_BUCKET=elimin8-photos
# Set unique local credentials before make up; never commit real values.
PHOTO_STORAGE_ACCESS_KEY=
PHOTO_STORAGE_SECRET_KEY=

# Positive whole hours after game end; photos become unreadable at this deadline.
PHOTO_RETENTION_HOURS=24
